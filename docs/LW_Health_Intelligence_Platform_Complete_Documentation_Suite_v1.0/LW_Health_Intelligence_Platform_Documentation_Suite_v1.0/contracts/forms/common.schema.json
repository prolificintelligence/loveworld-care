{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lwh:form-types:1.0.0",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "ref": {
      "type": "string",
      "format": "uuid"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "datetime": {
      "type": "string",
      "format": "date-time"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "texts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "concept": {
      "type": "object",
      "required": [
        "system",
        "code"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "display": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "period": {
      "type": "object",
      "required": [
        "start"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "quantity": {
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "unit": {
          "$ref": "#/$defs/concept"
        }
      },
      "additionalProperties": false
    },
    "money": {
      "type": "object",
      "required": [
        "minor_units",
        "currency",
        "scale"
      ],
      "properties": {
        "minor_units": {
          "type": "integer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": [
        "country_code"
      ],
      "properties": {
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "civil_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "address": {
          "type": "string"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "precision_source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "purpose",
          "value",
          "public"
        ],
        "properties": {
          "purpose": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "public": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "system",
          "value"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "verification": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "handover": {
      "type": "object",
      "required": [
        "recipient_ref",
        "state"
      ],
      "properties": {
        "recipient_ref": {
          "type": "string"
        },
        "state": {
          "enum": [
            "requested",
            "acknowledged",
            "accepted",
            "declined",
            "received",
            "completed"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_ref": {
          "type": "string"
        },
        "conditions": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "code",
        "status"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/concept"
        },
        "status": {
          "type": "string"
        },
        "quantity": {
          "$ref": "#/$defs/quantity"
        },
        "coded_value": {
          "$ref": "#/$defs/concept"
        },
        "text_value": {
          "type": "string"
        },
        "absent_reason": {
          "type": "string"
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string"
        },
        "reference_context": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "quantity"
          ]
        },
        {
          "required": [
            "coded_value"
          ]
        },
        {
          "required": [
            "text_value"
          ]
        },
        {
          "required": [
            "absent_reason"
          ]
        }
      ]
    },
    "finding": {
      "type": "object",
      "required": [
        "criterion_or_rule",
        "observation"
      ],
      "properties": {
        "criterion_or_rule": {
          "type": "string"
        },
        "observation": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "severity_policy_ref": {
          "type": "string"
        },
        "response": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "allergy": {
      "type": "object",
      "required": [
        "agent",
        "status",
        "source"
      ],
      "properties": {
        "agent": {
          "$ref": "#/$defs/concept"
        },
        "status": {
          "type": "string"
        },
        "reaction": {
          "type": "string"
        },
        "certainty": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "indicator_value": {
      "type": "object",
      "required": [
        "indicator",
        "definition_version"
      ],
      "properties": {
        "indicator": {
          "type": "string"
        },
        "definition_version": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "denominator": {
          "type": "number",
          "minimum": 0
        },
        "absent_reason": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "absent_reason"
          ]
        }
      ],
      "additionalProperties": false
    },
    "absence": {
      "type": "object",
      "required": [
        "absent_reason"
      ],
      "properties": {
        "absent_reason": {
          "enum": [
            "unknown",
            "not_assessed",
            "not_applicable",
            "not_available",
            "declined"
          ]
        },
        "explanation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "allergies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/allergy"
      }
    },
    "indicator_values": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/indicator_value"
      }
    },
    "money_lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/money"
      }
    },
    "ownership": {
      "enum": [
        "ministry_owned",
        "member_owned",
        "external"
      ]
    },
    "readiness": {
      "enum": [
        "available",
        "constrained",
        "unavailable",
        "unknown"
      ]
    },
    "review_state": {
      "enum": [
        "signal",
        "under_review",
        "verified",
        "returned_for_correction",
        "duplicate",
        "unsubstantiated",
        "closed"
      ]
    },
    "decision": {
      "enum": [
        "approve",
        "conditional",
        "reject",
        "suspend",
        "remove",
        "renew"
      ]
    },
    "allergy_status": {
      "enum": [
        "unknown",
        "not_assessed",
        "none_known",
        "known"
      ]
    },
    "report_status": {
      "enum": [
        "preliminary",
        "final",
        "corrected",
        "cancelled",
        "entered_in_error"
      ]
    },
    "admin_status": {
      "enum": [
        "given",
        "not_given",
        "held",
        "refused",
        "entered_in_error"
      ]
    },
    "stock_move": {
      "enum": [
        "receipt",
        "issue",
        "return",
        "quarantine",
        "adjustment",
        "reversal"
      ]
    },
    "erp_module": {
      "enum": [
        "accounting",
        "procurement",
        "hr",
        "payroll"
      ]
    }
  }
}