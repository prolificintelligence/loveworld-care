{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lwh:LWH-FRM-003:1.0.0",
  "title": "Facility periodic return",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "form_id",
    "schema_version",
    "stage",
    "authority_node_id",
    "actor_id",
    "facility_or_unit_id",
    "answers"
  ],
  "properties": {
    "form_id": {
      "const": "LWH-FRM-003"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "stage": {
      "enum": [
        "draft",
        "submitted"
      ]
    },
    "authority_node_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    },
    "facility_or_unit_id": {
      "type": "string",
      "format": "uuid"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "obligation_id": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/ref"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-003.F001 — Expected reporting unit/period record"
        },
        "template_version": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/text"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-003.F002 — Adopted form/indicator version"
        },
        "period": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/period"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-003.F003 — Local period with timezone"
        },
        "indicator_values": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/indicator_values"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-003.F004 — Counts/rates with source, unit and missingness"
        },
        "source_refs": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/refs"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-003.F005 — Extract/register/version references"
        },
        "limitations": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/text"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-003.F006 — Coverage and data gaps"
        },
        "attestation": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/text"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-003.F007 — Submitter declaration; separate from reviewer verification"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "submitted"
          }
        }
      },
      "then": {
        "properties": {
          "answers": {
            "required": [
              "obligation_id",
              "template_version",
              "period",
              "indicator_values",
              "source_refs",
              "attestation"
            ]
          }
        }
      }
    }
  ]
}