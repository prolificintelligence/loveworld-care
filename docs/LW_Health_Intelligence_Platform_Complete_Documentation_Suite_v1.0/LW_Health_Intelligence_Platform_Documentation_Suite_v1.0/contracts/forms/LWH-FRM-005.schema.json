{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lwh:LWH-FRM-005:1.0.0",
  "title": "Health event notification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "form_id",
    "schema_version",
    "stage",
    "authority_node_id",
    "actor_id",
    "facility_or_unit_id",
    "answers"
  ],
  "properties": {
    "form_id": {
      "const": "LWH-FRM-005"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "stage": {
      "enum": [
        "draft",
        "submitted"
      ]
    },
    "authority_node_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    },
    "facility_or_unit_id": {
      "type": "string",
      "format": "uuid"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_type": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/concept"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-005.F001 — Versioned occurrence/safety category"
        },
        "occurred_at": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/datetime"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-005.F002 — Occurrence or explicitly uncertain time"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/location"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-005.F003 — Minimum necessary precision"
        },
        "source_context": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/text"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-005.F004 — Reporter/source and what is known"
        },
        "review_state": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/review_state"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-005.F005 — Signal versus corroborated disposition"
        },
        "urgency_context": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/text"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-005.F006 — Concern for clinical duty assessment"
        },
        "related_report_refs": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/refs"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-005.F007 — Possible duplicate reports"
        },
        "owner_team_id": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/ref"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-005.F008 — Actual accountable review queue"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "submitted"
          }
        }
      },
      "then": {
        "properties": {
          "answers": {
            "required": [
              "event_type",
              "occurred_at",
              "source_context",
              "review_state",
              "owner_team_id"
            ]
          }
        }
      }
    }
  ]
}