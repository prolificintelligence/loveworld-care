{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lwh:LWH-FRM-032:1.0.0",
  "title": "Medication administration or omission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "form_id",
    "schema_version",
    "stage",
    "authority_node_id",
    "actor_id",
    "facility_or_unit_id",
    "answers"
  ],
  "properties": {
    "form_id": {
      "const": "LWH-FRM-032"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "stage": {
      "enum": [
        "draft",
        "submitted"
      ]
    },
    "authority_node_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    },
    "facility_or_unit_id": {
      "type": "string",
      "format": "uuid"
    },
    "patient_id": {
      "type": "string",
      "format": "uuid"
    },
    "encounter_id": {
      "type": "string",
      "format": "uuid"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order_version_id": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/ref"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-032.F001 — Rechecked current order"
        },
        "administration_status": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/admin_status"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-032.F002 — Given/not-given/held/refused/error"
        },
        "actual_product": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/concept"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-032.F003 — Required for a given dose"
        },
        "actual_dose": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/quantity"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-032.F004 — Required for a given dose"
        },
        "performed_at": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/datetime"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-032.F005 — Actual event time; late entry explicit"
        },
        "performer_id": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/ref"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-032.F006 — Actual competent actor"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/text"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-032.F007 — Required for omission/deviation"
        },
        "second_check_ref": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/ref"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-032.F008 — Where required by approved high-risk policy"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "submitted"
          }
        }
      },
      "then": {
        "properties": {
          "answers": {
            "required": [
              "order_version_id",
              "administration_status",
              "performed_at",
              "performer_id"
            ]
          }
        },
        "required": [
          "patient_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "submitted"
          },
          "answers": {
            "required": [
              "administration_status"
            ],
            "properties": {
              "administration_status": {
                "enum": [
                  "given"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "answers": {
            "required": [
              "actual_product",
              "actual_dose"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "submitted"
          },
          "answers": {
            "required": [
              "administration_status"
            ],
            "properties": {
              "administration_status": {
                "enum": [
                  "not_given",
                  "held",
                  "refused"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "answers": {
            "required": [
              "reason"
            ]
          }
        }
      }
    }
  ]
}