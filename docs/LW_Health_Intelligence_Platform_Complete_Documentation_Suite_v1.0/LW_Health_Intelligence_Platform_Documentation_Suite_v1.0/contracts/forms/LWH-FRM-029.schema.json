{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lwh:LWH-FRM-029:1.0.0",
  "title": "Diagnostic result and amendment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "form_id",
    "schema_version",
    "stage",
    "authority_node_id",
    "actor_id",
    "facility_or_unit_id",
    "answers"
  ],
  "properties": {
    "form_id": {
      "const": "LWH-FRM-029"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "stage": {
      "enum": [
        "draft",
        "submitted"
      ]
    },
    "authority_node_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    },
    "facility_or_unit_id": {
      "type": "string",
      "format": "uuid"
    },
    "patient_id": {
      "type": "string",
      "format": "uuid"
    },
    "encounter_id": {
      "type": "string",
      "format": "uuid"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order_refs": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/refs"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-029.F001 — Applicable orders/accessions"
        },
        "results": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/observations"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-029.F002 — Value/code/text with unit, method, absence and reference context"
        },
        "report_status": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/report_status"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-029.F003 — Preliminary/final/corrected/cancelled/error"
        },
        "verifier_id": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/ref"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-029.F004 — Required for authorised release"
        },
        "amends_version_id": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/ref"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-029.F005 — Required for correction"
        },
        "critical_review": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/handover"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-029.F006 — Adopted trigger, actual acknowledgement and response"
        },
        "source_document_refs": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/refs"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-029.F007 — External report/OCR provenance"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "submitted"
          }
        }
      },
      "then": {
        "properties": {
          "answers": {
            "required": [
              "order_refs",
              "results",
              "report_status"
            ]
          }
        },
        "required": [
          "patient_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "submitted"
          },
          "answers": {
            "required": [
              "report_status"
            ],
            "properties": {
              "report_status": {
                "enum": [
                  "final",
                  "corrected"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "answers": {
            "required": [
              "verifier_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "submitted"
          },
          "answers": {
            "required": [
              "report_status"
            ],
            "properties": {
              "report_status": {
                "enum": [
                  "corrected"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "answers": {
            "required": [
              "amends_version_id"
            ]
          }
        }
      }
    }
  ]
}