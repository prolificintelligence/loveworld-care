{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lwh:LWH-FRM-031:1.0.0",
  "title": "Medication dispensing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "form_id",
    "schema_version",
    "stage",
    "authority_node_id",
    "actor_id",
    "facility_or_unit_id",
    "answers"
  ],
  "properties": {
    "form_id": {
      "const": "LWH-FRM-031"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "stage": {
      "enum": [
        "draft",
        "submitted"
      ]
    },
    "authority_node_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    },
    "facility_or_unit_id": {
      "type": "string",
      "format": "uuid"
    },
    "patient_id": {
      "type": "string",
      "format": "uuid"
    },
    "encounter_id": {
      "type": "string",
      "format": "uuid"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order_version_id": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/ref"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-031.F001 — Current authorised intent"
        },
        "actual_product": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/concept"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-031.F002 — Actual dispensed product/strength"
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/quantity"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-031.F003 — Actual quantity/unit"
        },
        "lot_refs": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/refs"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-031.F004 — Batch/expiry traceability"
        },
        "dispensed_at": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/datetime"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-031.F005 — Actual event time"
        },
        "substitution_authority": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/text"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-031.F006 — Required if item differs"
        },
        "counselling_context": {
          "anyOf": [
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/text"
            },
            {
              "$ref": "urn:lwh:form-types:1.0.0#/$defs/absence"
            }
          ],
          "description": "LWH-FRM-031.F007 — Instructions provided and responsible staff"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "submitted"
          }
        }
      },
      "then": {
        "properties": {
          "answers": {
            "required": [
              "order_version_id",
              "actual_product",
              "quantity",
              "lot_refs",
              "dispensed_at"
            ]
          }
        },
        "required": [
          "patient_id"
        ]
      }
    }
  ]
}