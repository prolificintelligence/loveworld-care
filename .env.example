# =============================================================================
# LoveWorld Care — Production & Staging Environment Configuration Template
# All installations & caches MUST remain on D:\ drive (see scripts/env-d-drive.ps1)
# =============================================================================

# --- Runtime & Jurisdiction ---
LW_ENVIRONMENT=production
LW_JURISDICTION_DEFAULT=NG
LW_API_HOST=0.0.0.0
LW_API_PORT=8000
LW_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# --- Cloud-Hosted Managed PostgreSQL (Schema-Isolated: identity, care_clinical, finance_ledger, governance_audit, analytics) ---
LW_DATABASE_URL=postgresql+asyncpg://lw_care_app:REPLACE_WITH_STRONG_PASSWORD@ep-loveworld-care.eu-central-1.aws.neon.tech:5432/loveworld_care?ssl=require
LW_DATABASE_POOL_SIZE=20
LW_DATABASE_MAX_OVERFLOW=10

# --- Cloud-Hosted Redis (Session Revocation, Rate Limits, Distributed Locks) ---
LW_REDIS_URL=rediss://default:REPLACE_WITH_UPSTASH_TOKEN@loveworld-care.upstash.io:6379

# --- Cloud-Hosted Private S3 / Cloudflare R2 Storage (Clinical Documents, Signed PDFs, Attachments) ---
LW_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
LW_S3_REGION=auto
LW_S3_BUCKET_CLINICAL=loveworld-care-clinical-t3
LW_S3_BUCKET_EXPORTS=loveworld-care-finance-exports
LW_S3_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
LW_S3_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY
LW_S3_PRESIGNED_EXPIRY_SECONDS=300

# --- Identity, Cryptographic Signing & Security Controls (T4) ---
LW_JWT_SIGNING_KEY=REPLACE_WITH_256_BIT_HEX_SECRET
LW_SESSION_COOKIE_SECRET=REPLACE_WITH_256_BIT_HEX_SECRET
LW_CLINICAL_SIGNING_PRIVATE_KEY_PEM=REPLACE_WITH_ED25519_PRIVATE_KEY_BASE64
LW_CLINICAL_SIGNING_PUBLIC_KEY_PEM=REPLACE_WITH_ED25519_PUBLIC_KEY_BASE64
LW_AUDIT_HMAC_CHAIN_KEY=REPLACE_WITH_256_BIT_AUDIT_CHAIN_KEY
LW_BREAK_GLASS_MAX_DURATION_MINUTES=30

# --- Real-Time Clinical Communications (LiveKit WebRTC) ---
LW_LIVEKIT_URL=wss://loveworld-care.livekit.cloud
LW_LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
LW_LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET
LW_LIVEKIT_WEBHOOK_SECRET=REPLACE_WITH_LIVEKIT_WEBHOOK_SECRET
LW_RTC_RECORDING_ENABLED=false

# --- Payment Gateways (Paystack NGN, Flutterwave Multi-Currency, Espees Wallet ESP) ---
LW_PAYSTACK_SECRET_KEY=sk_live_REPLACE_ME
LW_PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_ME
LW_PAYSTACK_WEBHOOK_SECRET=sk_live_REPLACE_ME

LW_FLUTTERWAVE_SECRET_KEY=FLWSECK-REPLACE_ME
LW_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-REPLACE_ME
LW_FLUTTERWAVE_WEBHOOK_HASH=REPLACE_WITH_FLW_SECRET_HASH

LW_ESPEES_MERCHANT_CODE=LW_CARE_MERCHANT
LW_ESPEES_API_KEY=REPLACE_WITH_ESPEES_API_KEY
LW_ESPEES_WEBHOOK_SECRET=REPLACE_WITH_ESPEES_WEBHOOK_SECRET
LW_ESPEES_API_BASE_URL=https://api.espees.org/v2

# --- Secondary PHI-Free Messaging Adapters (KingsChat, Termii SMS, Resend/SMTP) ---
LW_KINGSCHAT_CLIENT_ID=REPLACE_WITH_KINGSCHAT_CLIENT_ID
LW_KINGSCHAT_CLIENT_SECRET=REPLACE_WITH_KINGSCHAT_CLIENT_SECRET
LW_KINGSCHAT_API_URL=https://connect.kingsch.at/api

LW_TERMII_API_KEY=REPLACE_WITH_TERMII_API_KEY
LW_TERMII_SENDER_ID=LWCare
LW_TERMII_BASE_URL=https://v3.api.termii.com

LW_RESEND_API_KEY=re_REPLACE_ME
LW_EMAIL_FROM=no-reply@care.loveworld.org

# --- Policy-Limited AI Model Gateway & Kill Switch (§15) ---
LW_AI_GLOBAL_KILL_SWITCH=false
LW_GEMINI_API_KEY=REPLACE_WITH_GEMINI_OR_VERTEX_KEY
LW_GEMINI_MODEL_ADMIN=gemini-2.5-flash
LW_MEDGEMMA_ENDPOINT_URL=https://medgemma-private.internal.loveworld.org/v1
LW_MEDGEMMA_API_KEY=REPLACE_WITH_PRIVATE_MODEL_KEY
LW_MEDGEMMA_MODEL_ID=google/medgemma-1.5-4b-it
LW_ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY
LW_AI_MAX_COST_MINOR_PER_ENCOUNTER=20000

# --- SponsorCare & Unit Economics Guardrails (§10.5 & §17.2) ---
LW_SPONSOR_SMALL_COHORT_MIN_K=5
LW_DEFAULT_GP_FEE_NGN_MINOR=600000
LW_DEFAULT_GP_CLINICIAN_PAYABLE_NGN_MINOR=330000
LW_DEFAULT_INSTITUTIONAL_ACCESS_FEE_NGN_MINOR=35000
